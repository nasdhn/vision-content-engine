generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum BriefStatus {
  DRAFT
  READY
  GENERATING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum IdeaSourceType {
  USER
  BRIEF_DERIVED
  PERFORMANCE_DERIVED
  RESEARCH_DERIVED
}

enum IdeaStatus {
  DRAFT
  ACTIVE
  EXHAUSTED
  ARCHIVED
}

enum SourceReferenceType {
  INTERNAL_PRODUCT
  INTERNAL_PRICING
  OFFICIAL_DOCUMENTATION
  PUBLIC_WEB
  MANUAL_REFERENCE
}

enum PatternStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum ConceptStatus {
  DRAFT
  AWAITING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum CreatorType {
  HUMAN
  AI
  HYBRID
}

enum ScriptStatus {
  DRAFT
  READY
  SUPERSEDED
  ARCHIVED
}

enum VoiceMode {
  NATURAL_USER_VOICE
  NO_VOICE
  OTHER_HUMAN
  AI_VOICE
}

enum CreativePlanStatus {
  DRAFT
  READY
  WAITING_FOR_INPUTS
  READY_FOR_EDITING
  SUPERSEDED
  ARCHIVED
}

enum RecordingRequestType {
  VOICE
  GREEN_SCREEN_VIDEO
  SCREEN_VIDEO
  BROLL
  OTHER
}

enum RecordingRequestStatus {
  PENDING
  READY_TO_RECORD
  UPLOADED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum RecordingStatus {
  UPLOADED
  SELECTED
  REJECTED
  ARCHIVED
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  FONT
  SUBTITLE
  JSON
  OTHER
}

enum AssetSourceType {
  UPLOAD
  RECORDING
  CAPTURE
  RENDER
  SYSTEM
  EXTERNAL
}

enum AssetStatus {
  UPLOADING
  READY
  FAILED
  QUARANTINED
  ARCHIVED
}

enum CaptureRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DefinitionStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum EditingPlanStatus {
  DRAFT
  READY
  SUPERSEDED
  ARCHIVED
}

enum RenderStatus {
  REQUESTED
  QUEUED
  RENDERING
  TECHNICAL_QA
  CREATIVE_QA
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  FAILED
  CANCELLED
}

enum AttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CreativeQaResult {
  PASS
  PASS_WITH_WARNINGS
  FAIL
}

enum ApprovalSubjectType {
  CONCEPT
  RENDER
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ApprovalActorType {
  USER
  SYSTEM
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
}

enum PlatformAccountStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISABLED
  ERROR
}

enum PublicationDeliveryMode {
  API_AUTOMATED
  MANUAL_HANDOFF
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  READY_FOR_MANUAL_PUBLISH
  PUBLISHING
  PUBLISHING_UNKNOWN
  PUBLISHED
  FAILED
  CANCELLED
}

enum AssetDerivationType {
  PLATFORM_DERIVATIVE
}

enum PublicationResponseClass {
  SUCCESS
  TRANSIENT_FAILURE
  PERMANENT_FAILURE
  RATE_LIMITED
  UNKNOWN_SIDE_EFFECT
}

enum AttributionEventType {
  WEBSITE_VISIT
  SIGNUP
  ACTIVATION
  CUSTOMER
  REVENUE
}

enum AttributionConfidenceType {
  DIRECT
  INFERRED
  UNKNOWN
}

enum AttributionSourceSystem {
  UMAMI
  VISION_APP
  STRIPE
  MANUAL
}

enum MetricCollectionMethod {
  PLATFORM_API
  MANUAL_ENTRY
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

enum InsightConfidence {
  INSUFFICIENT_DATA
  WEAK_SIGNAL
  INTERESTING_SIGNAL
  FAIRLY_SOLID
}

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXECUTED
}

enum WorkflowType {
  CONCEPT_GENERATION
  CREATIVE_PRODUCTION
  CAPTURE
  RENDER
  PUBLICATION
  ANALYTICS
  WEEKLY_ANALYSIS
}

enum WorkflowStatus {
  PENDING
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobAttemptStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  DISPATCHING
  DISPATCHED
  FAILED
}

enum ModelInvocationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED_SCHEMA
}

enum CostCategory {
  AI
  RENDER
  STORAGE
  BANDWIDTH
  PLATFORM
  OTHER
}

enum AuditActorType {
  USER
  SYSTEM
  WORKER
  AI
}

enum CaptureAssetRole {
  SCREENSHOT
  VIDEO
  FRAME
  TRACE
  LOG
  OTHER
}

enum RenderInputRole {
  VOICE
  GREEN_SCREEN_VIDEO
  PRODUCT_CAPTURE
  SCREENSHOT
  BROLL
  MUSIC
  SFX
  IMAGE
  SUBTITLE_SOURCE
  TEMPLATE_ASSET
  OTHER
}

enum TemplateAssetRole {
  LOGO
  FONT
  ICON
  BACKGROUND
  MUSIC
  SFX
  IMAGE
  VIDEO
  OTHER
}

model Campaign {
  id                String             @id @default(uuid(7)) @db.Uuid
  name              String
  slug              String             @unique
  objective         String?
  status            CampaignStatus     @default(DRAFT)
  startsAt          DateTime? @db.Timestamptz(3)
  endsAt            DateTime? @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  briefs            Brief[]
  experiments       Experiment[]
  attributionEvents AttributionEvent[]

  @@index([status, startsAt])
}

model Brief {
  id                 String      @id @default(uuid(7)) @db.Uuid
  campaignId         String      @db.Uuid
  title              String
  goal               String?
  audience           String?
  notes              String?
  priority           Int         @default(0)
  status             BriefStatus @default(DRAFT)
  topics             Json?
  productAreas       Json?
  mustMention        Json?
  mustAvoid          Json?
  preferredFormats   Json?
  targetPlatforms    Json?
  targetContentCount Int?
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  campaign           Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  versions           BriefVersion[]
  ideas              Idea[]
  concepts           Concept[]

  @@index([campaignId, status])
}

model BriefVersion {
  id              String           @id @default(uuid(7)) @db.Uuid
  briefId         String           @db.Uuid
  version         Int
  payloadJson     Json
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  createdBy       String?

  brief           Brief            @relation(fields: [briefId], references: [id], onDelete: Restrict)
  conceptVersions ConceptVersion[]

  @@unique([briefId, version])
}

model Idea {
  id                String         @id @default(uuid(7)) @db.Uuid
  briefId           String?        @db.Uuid
  title             String
  description       String?
  sourceType        IdeaSourceType
  sourceReferenceId String?        @db.Uuid
  status            IdeaStatus     @default(DRAFT)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  brief             Brief?             @relation(fields: [briefId], references: [id], onDelete: SetNull)
  sourceReference   SourceReference?   @relation(fields: [sourceReferenceId], references: [id], onDelete: SetNull)
  concepts          Concept[]

  @@index([briefId])
  @@index([sourceReferenceId])
  @@index([status, sourceType])
}

model SourceReference {
  id           String              @id @default(uuid(7)) @db.Uuid
  sourceType   SourceReferenceType
  title        String
  url          String?
  publisher    String?
  observedAt   DateTime? @db.Timestamptz(3)
  retrievedAt  DateTime? @db.Timestamptz(3)
  contentHash  String?
  metadataJson Json?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  ideas        Idea[]

  @@index([sourceType, createdAt])
  @@index([url])
}

model KnowledgeSnapshot {
  id          String           @id @default(uuid(7)) @db.Uuid
  key         String
  version     Int
  contentHash String
  status      DefinitionStatus @default(DRAFT)
  effectiveAt DateTime @db.Timestamptz(3)
  payloadJson Json
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  createdBy   String?

  modelInvocations ModelInvocation[]

  @@unique([key, version])
  @@unique([key, contentHash])
  @@index([key, status, effectiveAt])
}

model Pattern {
  id        String        @id @default(uuid(7)) @db.Uuid
  key       String        @unique
  name      String
  category  String?
  status    PatternStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  versions  PatternVersion[]
}

model PatternVersion {
  id                  String           @id @default(uuid(7)) @db.Uuid
  patternId           String           @db.Uuid
  version             Int
  description         String?
  whenToUse           String?
  audienceFitJson     Json?
  hookStructureJson   Json?
  storyStructureJson  Json?
  visualStructureJson Json?
  ctaStyleJson        Json?
  constraintsJson     Json?
  knownRisksJson      Json?
  examplesJson        Json?
  sourceType          String?
  sourceMetadataJson  Json?
  confidence          Float?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  createdBy           String?

  pattern             Pattern          @relation(fields: [patternId], references: [id], onDelete: Restrict)
  conceptVersions     ConceptVersion[]

  @@unique([patternId, version])
}

model Concept {
  id           String        @id @default(uuid(7)) @db.Uuid
  ideaId       String?       @db.Uuid
  briefId      String        @db.Uuid
  status       ConceptStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  idea         Idea?         @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  brief        Brief         @relation(fields: [briefId], references: [id], onDelete: Restrict)
  versions     ConceptVersion[]
  script       Script?
  creativePlan CreativePlan?

  @@index([briefId, status])
  @@index([ideaId])
}

model ConceptVersion {
  id                       String           @id @default(uuid(7)) @db.Uuid
  conceptId                String           @db.Uuid
  briefVersionId           String           @db.Uuid
  version                  Int
  title                    String
  angle                    String?
  hook                     String?
  audience                 String?
  objective                String?
  hypothesis               String?
  selectedPatternVersionId String?          @db.Uuid
  rationale                String?
  creatorType              CreatorType
  creatorModelInvocationId String?          @db.Uuid
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)

  concept                  Concept          @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  briefVersion             BriefVersion     @relation(fields: [briefVersionId], references: [id], onDelete: Restrict)
  selectedPatternVersion   PatternVersion?  @relation(fields: [selectedPatternVersionId], references: [id], onDelete: SetNull)
  creatorModelInvocation   ModelInvocation? @relation("ConceptCreatorInvocation", fields: [creatorModelInvocationId], references: [id], onDelete: SetNull)
  approvals                Approval[]
  experimentArms           ExperimentArm[]
  scriptVersions           ScriptVersion[]

  @@unique([conceptId, version])
  @@index([briefVersionId])
  @@index([selectedPatternVersionId])
}

model Script {
  id        String       @id @default(uuid(7)) @db.Uuid
  conceptId String       @unique @db.Uuid
  status    ScriptStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  concept   Concept         @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  versions  ScriptVersion[]
}

model ScriptVersion {
  id                  String           @id @default(uuid(7)) @db.Uuid
  scriptId            String           @db.Uuid
  conceptVersionId    String           @db.Uuid
  version             Int
  language            String           @default("fr")
  fullText            String
  segmentsJson        Json?
  estimatedDurationMs Int?
  voiceMode           VoiceMode        @default(NATURAL_USER_VOICE)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  createdByType       CreatorType
  modelInvocationId   String?          @db.Uuid

  script              Script           @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  conceptVersion      ConceptVersion   @relation(fields: [conceptVersionId], references: [id], onDelete: Restrict)
  modelInvocation     ModelInvocation? @relation("ScriptInvocation", fields: [modelInvocationId], references: [id], onDelete: SetNull)
  creativePlanVersions CreativePlanVersion[]

  @@unique([scriptId, version])
  @@index([conceptVersionId])
}

model CreativePlan {
  id          String             @id @default(uuid(7)) @db.Uuid
  conceptId   String             @unique @db.Uuid
  status      CreativePlanStatus @default(DRAFT)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  concept     Concept               @relation(fields: [conceptId], references: [id], onDelete: Restrict)
  versions    CreativePlanVersion[]
  editingPlan EditingPlan?
}

model CreativePlanVersion {
  id                         String           @id @default(uuid(7)) @db.Uuid
  creativePlanId             String           @db.Uuid
  version                    Int
  scriptVersionId            String           @db.Uuid
  targetDurationMs           Int?
  primaryFormat              String
  templateVersionId          String           @db.Uuid
  editingProfileVersionId    String           @db.Uuid
  scenePlanJson              Json
  requiredRecordingsJson     Json?
  requiredCapturesJson       Json?
  requiredAssetsJson         Json?
  ctaJson                    Json?
  platformConsiderationsJson Json?
  modelInvocationId          String?          @db.Uuid
  createdAt                  DateTime         @default(now()) @db.Timestamptz(3)

  creativePlan               CreativePlan          @relation(fields: [creativePlanId], references: [id], onDelete: Restrict)
  scriptVersion              ScriptVersion         @relation(fields: [scriptVersionId], references: [id], onDelete: Restrict)
  templateVersion            TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  editingProfileVersion      EditingProfileVersion @relation(fields: [editingProfileVersionId], references: [id], onDelete: Restrict)
  modelInvocation            ModelInvocation?      @relation("CreativePlanInvocation", fields: [modelInvocationId], references: [id], onDelete: SetNull)
  recordingRequests          RecordingRequest[]
  captureRuns                CaptureRun[]
  editingPlanVersions        EditingPlanVersion[]

  @@unique([creativePlanId, version])
  @@index([scriptVersionId])
  @@index([templateVersionId])
  @@index([editingProfileVersionId])
}

model RecordingRequest {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  creativePlanVersionId String                 @db.Uuid
  type                  RecordingRequestType
  title                 String
  instructions          String?
  scriptSegmentRef      String?
  shotInstructionsJson  Json?
  status                RecordingRequestStatus @default(PENDING)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  completedAt           DateTime? @db.Timestamptz(3)

  creativePlanVersion   CreativePlanVersion    @relation(fields: [creativePlanVersionId], references: [id], onDelete: Restrict)
  recordings            Recording[]

  @@index([creativePlanVersionId, status])
  @@index([status, createdAt])
}

model Recording {
  id                 String          @id @default(uuid(7)) @db.Uuid
  recordingRequestId String          @db.Uuid
  assetId            String          @db.Uuid
  takeNumber         Int
  status             RecordingStatus @default(UPLOADED)
  notes              String?
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)

  recordingRequest   RecordingRequest @relation(fields: [recordingRequestId], references: [id], onDelete: Restrict)
  asset              Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([recordingRequestId, takeNumber])
  @@index([assetId])
}

model Asset {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  kind                  AssetKind
  storageProvider       String
  bucket                String
  objectKey             String                 @unique
  checksumSha256        String?
  mimeType              String?
  sizeBytes             BigInt?
  width                 Int?
  height                Int?
  durationMs            Int?
  fps                   Float?
  audioChannels         Int?
  sampleRate            Int?
  status                AssetStatus            @default(UPLOADING)
  sourceType            AssetSourceType
  sourceEntityType      String?
  sourceEntityId        String?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  deletedAt             DateTime? @db.Timestamptz(3)

  recordings            Recording[]
  captureRunAssets      CaptureRunAsset[]
  renderInputAssets     RenderInputAsset[]
  templateVersionAssets TemplateVersionAsset[]
  renderOutputs         RenderAttempt[]        @relation("RenderOutputAsset")
  renderDiagnostics     RenderAttempt[]        @relation("RenderDiagnosticAsset")
  approvedForRenders    Render[]               @relation("ApprovedRenderAsset")
  publicationMedia      Publication[]          @relation("PublicationMediaAsset")
  derivedChildren        AssetDerivation[]       @relation("AssetDerivationSource")
  derivedFrom            AssetDerivation?        @relation("AssetDerivationDerived")

  @@index([sourceEntityType, sourceEntityId])
  @@index([status, createdAt])
}


model AssetDerivation {
  id                           String              @id @default(uuid(7)) @db.Uuid
  sourceAssetId                String              @db.Uuid
  derivedAssetId               String              @unique @db.Uuid
  type                         AssetDerivationType
  platform                     Platform?
  transformationProfileKey     String
  transformationProfileVersion String
  metadataJson                 Json?
  createdAt                    DateTime            @default(now()) @db.Timestamptz(3)

  sourceAsset                  Asset               @relation("AssetDerivationSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  derivedAsset                 Asset               @relation("AssetDerivationDerived", fields: [derivedAssetId], references: [id], onDelete: Restrict)

  @@index([sourceAssetId, createdAt])
  @@index([platform, type, createdAt])
}

model CaptureScenario {
  id        String           @id @default(uuid(7)) @db.Uuid
  key       String           @unique
  name      String
  status    DefinitionStatus @default(DRAFT)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  versions  CaptureScenarioVersion[]
}

model CaptureScenarioVersion {
  id                String          @id @default(uuid(7)) @db.Uuid
  captureScenarioId String          @db.Uuid
  version           Int
  targetEnvironment String
  stepsJson         Json
  inputSchemaJson   Json?
  outputSpecJson    Json?
  browserConfigJson Json?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  createdBy         String?

  captureScenario   CaptureScenario @relation(fields: [captureScenarioId], references: [id], onDelete: Restrict)
  runs              CaptureRun[]

  @@unique([captureScenarioId, version])
}

model CaptureRun {
  id                       String           @id @default(uuid(7)) @db.Uuid
  captureScenarioVersionId String           @db.Uuid
  creativePlanVersionId    String?          @db.Uuid
  operationId              String           @default(uuid(7)) @unique @db.Uuid
  status                   CaptureRunStatus @default(PENDING)
  startedAt                DateTime? @db.Timestamptz(3)
  finishedAt               DateTime? @db.Timestamptz(3)
  failureCode              String?
  failureMessage           String?
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)

  captureScenarioVersion   CaptureScenarioVersion @relation(fields: [captureScenarioVersionId], references: [id], onDelete: Restrict)
  creativePlanVersion      CreativePlanVersion?    @relation(fields: [creativePlanVersionId], references: [id], onDelete: SetNull)
  assets                   CaptureRunAsset[]

  @@index([status, createdAt])
  @@index([creativePlanVersionId])
}

model CaptureRunAsset {
  captureRunId String           @db.Uuid
  assetId      String           @db.Uuid
  role         CaptureAssetRole
  sequence     Int?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  captureRun   CaptureRun @relation(fields: [captureRunId], references: [id], onDelete: Restrict)
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([captureRunId, assetId, role])
  @@index([assetId])
}

model Template {
  id        String           @id @default(uuid(7)) @db.Uuid
  key       String           @unique
  name      String
  category  String?
  status    DefinitionStatus @default(DRAFT)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  versions  TemplateVersion[]
}

model TemplateVersion {
  id                        String                 @id @default(uuid(7)) @db.Uuid
  templateId                String                 @db.Uuid
  version                   Int
  inputSchemaJson           Json
  supportedAspectRatiosJson Json?
  minDurationMs             Int?
  maxDurationMs             Int?
  requiredSlotsJson         Json?
  optionalSlotsJson         Json?
  capabilitiesJson          Json?
  rendererVersion           String
  sourceRevision            String?
  createdAt                 DateTime               @default(now()) @db.Timestamptz(3)

  template                  Template               @relation(fields: [templateId], references: [id], onDelete: Restrict)
  assets                    TemplateVersionAsset[]
  creativePlanVersions      CreativePlanVersion[]
  editingPlanVersions       EditingPlanVersion[]

  @@unique([templateId, version])
}

model TemplateVersionAsset {
  templateVersionId String            @db.Uuid
  assetId           String            @db.Uuid
  role              TemplateAssetRole
  slotKey           String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)

  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([templateVersionId, assetId, role])
  @@index([assetId])
}

model EditingProfile {
  id        String           @id @default(uuid(7)) @db.Uuid
  key       String           @unique
  name      String
  status    DefinitionStatus @default(DRAFT)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  versions  EditingProfileVersion[]
}

model EditingProfileVersion {
  id                   String                 @id @default(uuid(7)) @db.Uuid
  editingProfileId     String                 @db.Uuid
  version              Int
  pacingRulesJson      Json?
  cutRulesJson         Json?
  captionRulesJson     Json?
  focusRulesJson       Json?
  motionRulesJson      Json?
  soundRulesJson       Json?
  hookRulesJson        Json?
  endingRulesJson      Json?
  greenScreenRulesJson Json?
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)

  editingProfile       EditingProfile         @relation(fields: [editingProfileId], references: [id], onDelete: Restrict)
  creativePlanVersions CreativePlanVersion[]
  editingPlanVersions  EditingPlanVersion[]

  @@unique([editingProfileId, version])
}

model EditingPlan {
  id             String            @id @default(uuid(7)) @db.Uuid
  creativePlanId String            @unique @db.Uuid
  status         EditingPlanStatus @default(DRAFT)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  creativePlan   CreativePlan        @relation(fields: [creativePlanId], references: [id], onDelete: Restrict)
  versions       EditingPlanVersion[]
}

model EditingPlanVersion {
  id                      String                @id @default(uuid(7)) @db.Uuid
  editingPlanId           String                @db.Uuid
  version                 Int
  creativePlanVersionId   String                @db.Uuid
  editingProfileVersionId String                @db.Uuid
  templateVersionId       String                @db.Uuid
  timelineJson            Json
  captionPlanJson         Json?
  audioPlanJson           Json?
  visualFocusJson         Json?
  transitionPlanJson      Json?
  greenScreenPlanJson     Json?
  renderSettingsJson      Json?
  modelInvocationId       String?               @db.Uuid
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)

  editingPlan             EditingPlan           @relation(fields: [editingPlanId], references: [id], onDelete: Restrict)
  creativePlanVersion     CreativePlanVersion   @relation(fields: [creativePlanVersionId], references: [id], onDelete: Restrict)
  editingProfileVersion   EditingProfileVersion @relation(fields: [editingProfileVersionId], references: [id], onDelete: Restrict)
  templateVersion         TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  modelInvocation         ModelInvocation?      @relation("EditingPlanInvocation", fields: [modelInvocationId], references: [id], onDelete: SetNull)
  renders                 Render[]

  @@unique([editingPlanId, version])
  @@index([creativePlanVersionId])
}

model Render {
  id                   String       @id @default(uuid(7)) @db.Uuid
  editingPlanVersionId String       @db.Uuid
  operationId          String       @default(uuid(7)) @unique @db.Uuid
  status               RenderStatus @default(REQUESTED)
  approvedAssetId      String?      @db.Uuid
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  editingPlanVersion   EditingPlanVersion @relation(fields: [editingPlanVersionId], references: [id], onDelete: Restrict)
  approvedAsset        Asset?             @relation("ApprovedRenderAsset", fields: [approvedAssetId], references: [id], onDelete: SetNull)
  inputAssets          RenderInputAsset[]
  attempts             RenderAttempt[]
  approvals            Approval[]
  publications         Publication[]

  @@index([status, createdAt])
}

model RenderInputAsset {
  renderId  String          @db.Uuid
  assetId   String          @db.Uuid
  role      RenderInputRole
  slotKey   String?
  sequence  Int?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  render    Render @relation(fields: [renderId], references: [id], onDelete: Restrict)
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([renderId, assetId, role])
  @@index([assetId])
}

model RenderAttempt {
  id                String           @id @default(uuid(7)) @db.Uuid
  renderId          String           @db.Uuid
  attemptNumber     Int
  status            AttemptStatus    @default(QUEUED)
  workerVersion     String?
  rendererVersion   String?
  startedAt         DateTime? @db.Timestamptz(3)
  finishedAt        DateTime? @db.Timestamptz(3)
  failureCode       String?
  failureMessage    String?
  outputAssetId     String?          @db.Uuid
  diagnosticAssetId String?          @db.Uuid
  technicalQaJson   Json?
  creativeQaResult            CreativeQaResult?
  creativeQaJson              Json?
  creativeQaModelInvocationId String?          @db.Uuid
  createdAt                   DateTime         @default(now()) @db.Timestamptz(3)

  render            Render           @relation(fields: [renderId], references: [id], onDelete: Restrict)
  outputAsset              Asset?           @relation("RenderOutputAsset", fields: [outputAssetId], references: [id], onDelete: SetNull)
  diagnosticAsset          Asset?           @relation("RenderDiagnosticAsset", fields: [diagnosticAssetId], references: [id], onDelete: SetNull)
  creativeQaModelInvocation ModelInvocation? @relation("CreativeQaInvocation", fields: [creativeQaModelInvocationId], references: [id], onDelete: SetNull)
  costEntries              CostEntry[]

  @@unique([renderId, attemptNumber])
  @@index([status, createdAt])
  @@index([creativeQaModelInvocationId])
}

model Approval {
  id               String              @id @default(uuid(7)) @db.Uuid
  subjectType      ApprovalSubjectType
  conceptVersionId String?             @db.Uuid
  renderId         String?             @db.Uuid
  decision         ApprovalDecision
  reasonCode       String?
  comment          String?
  actorType        ApprovalActorType
  actorId          String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  conceptVersion   ConceptVersion?     @relation(fields: [conceptVersionId], references: [id], onDelete: Restrict)
  render           Render?             @relation(fields: [renderId], references: [id], onDelete: Restrict)

  @@index([subjectType, createdAt])
  @@index([conceptVersionId, createdAt])
  @@index([renderId, createdAt])
}

model PlatformAccount {
  id               String                @id @default(uuid(7)) @db.Uuid
  platform         Platform
  displayName      String
  remoteAccountId  String
  status           PlatformAccountStatus @default(ACTIVE)
  credentialsRef   String?
  capabilitiesJson Json?
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  publications     Publication[]

  @@unique([platform, remoteAccountId])
  @@index([status])
}

model Publication {
  id                String            @id @default(uuid(7)) @db.Uuid
  renderId          String            @db.Uuid
  platformAccountId String            @db.Uuid
  operationId       String                    @default(uuid(7)) @unique @db.Uuid
  trackingCode      String                    @default(uuid(7)) @unique @db.Uuid
  deliveryMode      PublicationDeliveryMode
  status            PublicationStatus           @default(DRAFT)
  scheduledAt       DateTime? @db.Timestamptz(3)
  publishedAt       DateTime? @db.Timestamptz(3)
  remotePostId      String?
  remoteUrl         String?
  mediaAssetId      String?            @db.Uuid
  metadataJson      Json
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  render            Render                     @relation(fields: [renderId], references: [id], onDelete: Restrict)
  platformAccount   PlatformAccount            @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)
  mediaAsset        Asset?                     @relation("PublicationMediaAsset", fields: [mediaAssetId], references: [id], onDelete: Restrict)
  attempts          PublicationAttempt[]
  rawMetrics        MetricSnapshotRaw[]
  normalizedMetrics MetricSnapshotNormalized[]
  attributionEvents AttributionEvent[]
  experimentArms    ExperimentArm[]
  costEntries       CostEntry[]

  @@unique([platformAccountId, remotePostId])
  @@index([status, scheduledAt])
  @@index([deliveryMode, status, scheduledAt])
  @@index([platformAccountId, publishedAt])
  @@index([renderId])
}

model PublicationAttempt {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  publicationId        String                    @db.Uuid
  attemptNumber        Int
  status               AttemptStatus             @default(QUEUED)
  startedAt            DateTime? @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)
  remoteRequestId      String?
  remotePostId         String?
  responseClass        PublicationResponseClass?
  responseMetadataJson Json?
  failureCode          String?
  failureMessage       String?
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)

  publication          Publication               @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@unique([publicationId, attemptNumber])
  @@index([status, createdAt])
}

model MetricSnapshotRaw {
  id                    String   @id @default(uuid(7)) @db.Uuid
  publicationId         String   @db.Uuid
  platform              Platform
  collectedAt           DateTime @db.Timestamptz(3)
  providerSchemaVersion String?
  collectionMethod      MetricCollectionMethod
  collectionOperationId String                 @unique @db.Uuid
  payloadJson           Json
  payloadHash           String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  publication           Publication                @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  normalizedSnapshots   MetricSnapshotNormalized[]

  @@index([publicationId, collectedAt])
  @@index([platform, collectionMethod, collectedAt])
}

model MetricSnapshotNormalized {
  id                   String             @id @default(uuid(7)) @db.Uuid
  publicationId        String             @db.Uuid
  rawSnapshotId        String             @db.Uuid
  collectedAt          DateTime @db.Timestamptz(3)
  views                BigInt?
  engagedViews         BigInt?
  reach                BigInt?
  impressions          BigInt?
  likes                BigInt?
  comments             BigInt?
  shares               BigInt?
  saves                BigInt?
  watchTimeMs          BigInt?
  avgWatchDurationMs   Int?
  avgWatchPercentage   Float?
  completionRate       Float?
  profileVisits        BigInt?
  websiteClicks        BigInt?
  follows              BigInt?
  otherMetricsJson     Json?
  availabilityJson     Json?
  comparabilityJson    Json?
  normalizerVersion    String
  metricSemanticsVersion String
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)

  publication          Publication        @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  rawSnapshot          MetricSnapshotRaw  @relation(fields: [rawSnapshotId], references: [id], onDelete: Restrict)

  @@unique([rawSnapshotId, normalizerVersion])
  @@index([publicationId, collectedAt])
}

model AttributionEvent {
  id                String                    @id @default(uuid(7)) @db.Uuid
  publicationId     String?                   @db.Uuid
  campaignId        String?                   @db.Uuid
  eventType         AttributionEventType
  occurredAt        DateTime @db.Timestamptz(3)
  source            String?
  sourceSystem      AttributionSourceSystem
  externalEventId   String
  confidenceType    AttributionConfidenceType
  externalVisitorId String?
  userId            String?
  valueAmountMinor  BigInt?
  valueCurrency     String?
  metadataJson      Json?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)

  publication       Publication?              @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  campaign          Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, externalEventId])
  @@index([eventType, occurredAt])
  @@index([publicationId, occurredAt])
  @@index([campaignId, occurredAt])
}

model Experiment {
  id            String           @id @default(uuid(7)) @db.Uuid
  campaignId    String?          @db.Uuid
  name          String
  hypothesis    String
  primaryMetric String?
  status        ExperimentStatus @default(DRAFT)
  startedAt     DateTime? @db.Timestamptz(3)
  endedAt       DateTime? @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  campaign      Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  arms          ExperimentArm[]

  @@index([campaignId, status])
}

model ExperimentArm {
  id               String          @id @default(uuid(7)) @db.Uuid
  experimentId     String          @db.Uuid
  label            String
  conceptVersionId String?         @db.Uuid
  publicationId    String?         @db.Uuid
  variablesJson    Json
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  experiment       Experiment      @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  conceptVersion   ConceptVersion? @relation(fields: [conceptVersionId], references: [id], onDelete: SetNull)
  publication      Publication?    @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([experimentId])
  @@index([conceptVersionId])
  @@index([publicationId])
}

model Insight {
  id                String            @id @default(uuid(7)) @db.Uuid
  scopeType         String
  scopeId           String?
  statement         String
  confidence        InsightConfidence
  evidenceJson      Json
  limitationsJson   Json?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  modelInvocationId String?           @db.Uuid

  modelInvocation   ModelInvocation?  @relation("InsightInvocation", fields: [modelInvocationId], references: [id], onDelete: SetNull)
  recommendations   Recommendation[]

  @@index([scopeType, scopeId, createdAt])
}

model Recommendation {
  id                  String               @id @default(uuid(7)) @db.Uuid
  insightId           String?              @db.Uuid
  title               String
  description         String?
  recommendedTestJson Json?
  status              RecommendationStatus @default(PROPOSED)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)

  insight             Insight?             @relation(fields: [insightId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model WorkflowRun {
  id             String         @id @default(uuid(7)) @db.Uuid
  workflowType   WorkflowType
  rootEntityType String
  rootEntityId   String
  status         WorkflowStatus @default(PENDING)
  currentStep    String?
  startedAt      DateTime? @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  jobAttempts    JobAttempt[]

  @@index([status, workflowType])
  @@index([rootEntityType, rootEntityId])
}

model JobAttempt {
  id             String           @id @default(uuid(7)) @db.Uuid
  workflowRunId  String?          @db.Uuid
  queueName      String
  jobType        String
  operationId    String           @db.Uuid
  bullJobId      String?
  attemptNumber  Int
  status         JobAttemptStatus @default(QUEUED)
  workerId       String?
  startedAt      DateTime? @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  failureCode    String?
  failureMessage String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  workflowRun    WorkflowRun?     @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@unique([operationId, attemptNumber, jobType])
  @@index([status, queueName, createdAt])
}

model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String
  payloadJson   Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  dispatchedAt  DateTime? @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model ModelInvocation {
  id                   String                @id @default(uuid(7)) @db.Uuid
  purpose              String
  requestedProvider    String?
  requestedModel       String?
  reasoningLevel       String?
  promptKey            String
  promptVersion        String
  promptContentHash    String
  knowledgeSnapshotId  String                @db.Uuid
  inputSchemaVersion   String
  outputSchemaVersion  String
  policyJson           Json?
  status               ModelInvocationStatus @default(RUNNING)
  inputHash            String
  outputHash           String?
  attemptCount         Int                   @default(0)
  inputTokens          Int?
  outputTokens         Int?
  cachedInputTokens    Int?
  latencyMs            Int?
  costAmount           Decimal?              @db.Decimal(18, 8)
  costCurrency         String?
  relatedEntityType    String?
  relatedEntityId      String?
  validationJson       Json?
  startedAt            DateTime @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)
  failureCode          String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)

  knowledgeSnapshot    KnowledgeSnapshot      @relation(fields: [knowledgeSnapshotId], references: [id], onDelete: Restrict)
  attempts             ModelInvocationAttempt[]
  conceptVersions      ConceptVersion[]       @relation("ConceptCreatorInvocation")
  scriptVersions       ScriptVersion[]        @relation("ScriptInvocation")
  creativePlanVersions CreativePlanVersion[]  @relation("CreativePlanInvocation")
  editingPlanVersions  EditingPlanVersion[]   @relation("EditingPlanInvocation")
  creativeQaAttempts   RenderAttempt[]        @relation("CreativeQaInvocation")
  insights             Insight[]              @relation("InsightInvocation")
  costEntries          CostEntry[]

  @@index([purpose, createdAt])
  @@index([knowledgeSnapshotId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
}

model ModelInvocationAttempt {
  id                   String                @id @default(uuid(7)) @db.Uuid
  modelInvocationId    String                @db.Uuid
  attemptNumber        Int
  provider             String
  model                String
  reasoningLevel       String?
  status               ModelInvocationStatus @default(RUNNING)
  requestHash          String
  responseHash         String?
  requestPayloadRef    String?
  responsePayloadRef   String?
  rawPayloadExpiresAt  DateTime? @db.Timestamptz(3)
  inputTokens          Int?
  outputTokens         Int?
  cachedInputTokens    Int?
  latencyMs            Int?
  costAmount           Decimal?              @db.Decimal(18, 8)
  costCurrency         String?
  validationJson       Json?
  failureCode          String?
  startedAt            DateTime @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)

  modelInvocation      ModelInvocation       @relation(fields: [modelInvocationId], references: [id], onDelete: Restrict)

  @@unique([modelInvocationId, attemptNumber])
  @@index([status, createdAt])
}
model CostEntry {
  id                String       @id @default(uuid(7)) @db.Uuid
  category          CostCategory
  provider          String?
  amount            Decimal      @db.Decimal(18, 8)
  currency          String
  quantity          Decimal?     @db.Decimal(18, 8)
  unit              String?
  relatedEntityType String?
  relatedEntityId   String?
  modelInvocationId String?      @db.Uuid
  renderAttemptId   String?      @db.Uuid
  publicationId     String?      @db.Uuid
  occurredAt        DateTime @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  metadataJson      Json?

  modelInvocation   ModelInvocation? @relation(fields: [modelInvocationId], references: [id], onDelete: SetNull)
  renderAttempt     RenderAttempt?   @relation(fields: [renderAttemptId], references: [id], onDelete: SetNull)
  publication       Publication?     @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([category, occurredAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([modelInvocationId])
  @@index([renderAttemptId])
  @@index([publicationId])
}

model AuditEvent {
  id               String         @id @default(uuid(7)) @db.Uuid
  actorType        AuditActorType
  actorId          String?
  action           String
  subjectType      String
  subjectId        String
  subjectVersionId String?
  beforeJson       Json?
  afterJson        Json?
  metadataJson     Json?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt])
  @@index([action, createdAt])
}
