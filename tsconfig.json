{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "prisma.config.ts",
    "vitest.config.ts",
    "vitest.postgres.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "packages/database/src/generated"]
}
